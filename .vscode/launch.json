{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387

  "version": "0.2.0",
  "configurations": [
    {
      "name": "Trailblazer — Debug (Real GPS)",
      "type": "dart",
      "request": "launch",
      "program": "src/trailblazer/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define=SIMULATE_MOVEMENT=false",
        "--dart-define=ACCESS_TOKEN=${env:MAPBOX_ACCESS_TOKEN}"
      ]
    },
    {
      "name": "Trailblazer — Debug (Simulated Movement)",
      "type": "dart",
      "request": "launch",
      "program": "src/trailblazer/lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define=SIMULATE_MOVEMENT=true",
        "--dart-define=ACCESS_TOKEN=${env:MAPBOX_ACCESS_TOKEN}"
      ]
    },
    {
      "name": "Trailblazer — Profile (Real GPS)",
      "type": "dart",
      "request": "launch",
      "program": "src/trailblazer/lib/main.dart",
      "flutterMode": "profile",
      "toolArgs": [
        "--dart-define=SIMULATE_MOVEMENT=false",
        "--dart-define=ACCESS_TOKEN=${env:MAPBOX_ACCESS_TOKEN}"
      ]
    },
    {
      "name": "Trailblazer — Release (Real GPS)",
      "type": "dart",
      "request": "launch",
      "program": "src/trailblazer/lib/main.dart",
      "flutterMode": "release",
      "toolArgs": [
        "--dart-define=SIMULATE_MOVEMENT=false",
        "--dart-define=ACCESS_TOKEN=${env:MAPBOX_ACCESS_TOKEN}"
      ]
    },
    {
      "name": "Trailblazer — Release (Simulated Movement)",
      "type": "dart",
      "request": "launch",
      "program": "src/trailblazer/lib/main.dart",
      "flutterMode": "release",
      "toolArgs": [
        "--dart-define=SIMULATE_MOVEMENT=true",
        "--dart-define=ACCESS_TOKEN=${env:MAPBOX_ACCESS_TOKEN}"
      ]
    }
  ]
}
